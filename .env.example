# Cloudsmith API key (required)
# Generate at: https://app.cloudsmith.com/user/settings/api/
CLOUDSMITH_API_KEY=your_api_key_here

# Optional defaults for workspace and repo dropdowns
CLOUDSMITH_OWNER=your_org
CLOUDSMITH_REPO=your_repo

# Comma-separated allowed CORS origins (defaults to http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000
