# Environment & secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Node
node_modules/

# Generated output
*.log
backend/.cache/
*.tsbuildinfo

# Vulnerability scan reports. They name real workspaces, repositories and image
# digests, so they are working output rather than something to publish.
reports/

# Working screenshots. The README's own images live in assets/readme/.
/*.jpg
/*.png

# Pasted into the Docker Hub overview field rather than read from the repo, so
# it lives here only as a working copy.
DOCKERHUB.md

# Design notes, planning exports and the scratch scripts behind them. Working
# material rather than documentation anyone pulling the repo needs.
docs/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Claude Code. Local tooling state, including the project commands: useful to
# whoever is working in the repo, not part of what the repo ships.
.claude/
